{
  "name": "@fast-agent/sdk",
  "version": "0.1.0",
  "description": "TypeScript client SDK for fast-agent-node.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "completion",
    "forms",
    "fastify",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuxnode/fast-llm-node.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "sideEffects": false
}
